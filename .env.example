# 复制为 .env 后填写。密钥只在服务端使用，不会进入浏览器。
#
# OpenAI 兼容接口的 base 地址，通常以 /v1 结尾。
# 例如：https://api.openai.com/v1
#       https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 未填写 LLM_API_KEY 时，服务端会尝试从同级项目的 .env 借用凭据：
# ../Vibe-Trading-main/agent/.env 中的 OPENAI_API_KEY / OPENAI_BASE_URL
# 可用 FALLBACK_ENV_PATH 指向其他文件，或设为 none 关闭。
# FALLBACK_ENV_PATH=

PORT=8787